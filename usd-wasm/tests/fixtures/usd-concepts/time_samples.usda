#usda 1.0
(
    startTimeCode = 1
    endTimeCode = 48
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "AnimatedCube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 0.65
        double3 xformOp:translate.timeSamples = {
            1: (0.8, 0, 0),
            5: (0.6883, 0.4077, 0.0623),
            9: (0.3845, 0.7016, 0.1846),
            13: (-0.0267, 0.7996, 0.2397),
            17: (-0.4305, 0.6743, 0.1705),
            21: (-0.714, 0.3608, 0.0488),
            25: (-0.7982, -0.0534, 0.0011),
            29: (-0.6596, -0.4528, 0.0769),
            33: (-0.3367, -0.7257, 0.1975),
            37: (0.0801, -0.796, 0.2376),
            41: (0.4745, -0.6441, 0.1556),
            45: (0.7365, -0.3123, 0.0366),
            48: (0.8, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Looks/AnimatedMat>
    }
}

def Scope "Looks"
{
    def Material "AnimatedMat"
    {
        token outputs:surface.connect = </Looks/AnimatedMat/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.timeSamples = {
                1: (0.15, 0.388, 1),
                5: (0.346, 0.15, 1),
                9: (0.7801, 0.15, 1),
                13: (1, 0.15, 0.7859),
                17: (1, 0.15, 0.3518),
                21: (1, 0.3822, 0.15),
                25: (1, 0.8163, 0.15),
                29: (0.7497, 1, 0.15),
                33: (0.3157, 1, 0.15),
                37: (0.15, 1, 0.4184),
                41: (0.15, 1, 0.8524),
                45: (0.15, 0.7135, 1),
                48: (0.15, 0.388, 1),
            }
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }
}
