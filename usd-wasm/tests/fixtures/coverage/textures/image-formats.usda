#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 42
        float horizontalAperture = 36
        float verticalAperture = 27
        matrix4d xformOp:transform = ( (0.7808688094430304, -2.775557561562892e-17, -0.6246950475544243, 0), (-0.17913857833742977, 0.9580019624132116, -0.22392322292178726, 0), (0.5984590814669529, 0.2867616432029149, 0.7480738518336912, -0), (4.8, 3.4, 6, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def "Lights"
    {
        def DistantLight "Key"
        {
            color3f inputs:color = (1, 0.93, 0.82)
            float inputs:intensity = 3
            bool inputs:normalize = 1
            float3 xformOp:rotateXYZ = (-35, -35, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DistantLight "Fill"
        {
            color3f inputs:color = (0.65, 0.8, 1)
            float inputs:intensity = 0.8
            bool inputs:normalize = 1
            float3 xformOp:rotateXYZ = (-15, 125, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DomeLight "Sky"
        {
            float inputs:intensity = 0.45
        }
    }

    def "Looks"
    {
        def Material "Base"
        {
            token outputs:surface.connect = </World/Looks/Base/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.09, 0.12)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Format0"
        {
            token outputs:surface.connect = </World/Looks/Format0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.54, 0.5)
                color3f inputs:diffuseColor.connect = </World/Looks/Format0/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @mosaic.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/Format0/UV.outputs:result>
                float outputs:a
                float outputs:b
                float outputs:g
                float outputs:r
                float3 outputs:rgb
            }
        }

        def Material "Format1"
        {
            token outputs:surface.connect = </World/Looks/Format1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.4, 0.8)
                color3f inputs:diffuseColor.connect = </World/Looks/Format1/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @fabric.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/Format1/UV.outputs:result>
                float outputs:a
                float outputs:b
                float outputs:g
                float outputs:r
                float3 outputs:rgb
            }
        }

        def Material "Format2"
        {
            token outputs:surface.connect = </World/Looks/Format2/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.22, 0.12)
                color3f inputs:diffuseColor.connect = </World/Looks/Format2/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @signal.tga@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/Format2/UV.outputs:result>
                float outputs:a
                float outputs:b
                float outputs:g
                float outputs:r
                float3 outputs:rgb
            }
        }
    }

