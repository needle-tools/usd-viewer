#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 42
        float horizontalAperture = 36
        float verticalAperture = 27
        matrix4d xformOp:transform = ( (0.7808688094430304, -2.775557561562892e-17, -0.6246950475544243, 0), (-0.17913857833742977, 0.9580019624132116, -0.22392322292178726, 0), (0.5984590814669529, 0.2867616432029149, 0.7480738518336912, -0), (4.8, 3.4, 6, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def "Lights"
    {
        def DistantLight "Key"
        {
            color3f inputs:color = (1, 0.93, 0.82)
            float inputs:intensity = 3
            bool inputs:normalize = 1
            float3 xformOp:rotateXYZ = (-35, -35, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DistantLight "Fill"
        {
            color3f inputs:color = (0.65, 0.8, 1)
            float inputs:intensity = 0.8
            bool inputs:normalize = 1
            float3 xformOp:rotateXYZ = (-15, 125, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DomeLight "Sky"
        {
            float inputs:intensity = 0.45
        }
    }

    def "Looks"
    {
        def Material "Base"
        {
            token outputs:surface.connect = </World/Looks/Base/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.09, 0.12)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Mosaic"
        {
            token outputs:surface.connect = </World/Looks/Mosaic/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.54, 0.5)
                color3f inputs:diffuseColor.connect = </World/Looks/Mosaic/Texture.outputs:rgb>
                float inputs:metallic = 0.1
                float inputs:roughness = 0.23
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @mosaic.ktx2@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/Mosaic/UV.outputs:result>
                float outputs:a
                float outputs:b
                float outputs:g
                float outputs:r
                float3 outputs:rgb
            }
        }
    }

    def Mesh "Base" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 4, 7, 3, 1, 2, 6, 5, 3, 7, 6, 2, 0, 1, 5, 4]
        rel material:binding = </World/Looks/Base>
        point3f[] points = [(-0.5, -0.5, -0.5), (0.5, -0.5, -0.5), (0.5, 0.5, -0.5), (-0.5, 0.5, -0.5), (-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (0.5, 0.5, 0.5), (-0.5, 0.5, 0.5)]
        color3f[] primvars:displayColor = [(0.055, 0.09, 0.12)]
        uniform token subdivisionScheme = "catmullClark"
        float3 xformOp:scale = (4.5, 0.2, 2.4)
        double3 xformOp:translate = (0, -0.12, 0)
