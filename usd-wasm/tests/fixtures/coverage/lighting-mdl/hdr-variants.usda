        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Lights" (
        variants = {
            string environment = "day"
        }
        prepend variantSets = "environment"
    )
    {
        variantSet "environment" = {
            "day" {
                def DomeLight "Environment"
                {
                    float inputs:intensity = 1
                    asset inputs:texture:file = @./studio-day.hdr@
                    token inputs:texture:format = "latlong"
                    float xformOp:rotateY = 0
                    uniform token[] xformOpOrder = ["xformOp:rotateY"]
                }

            }
            "dayRotated" {
                def DomeLight "Environment"
                {
                    float inputs:intensity = 1
                    asset inputs:texture:file = @./studio-day.hdr@
                    token inputs:texture:format = "latlong"
                    float xformOp:rotateY = 90
                    uniform token[] xformOpOrder = ["xformOp:rotateY"]
                }

            }
            "night" {
                def DomeLight "Environment"
                {
                    float inputs:intensity = 1
                    asset inputs:texture:file = @./studio-night.hdr@
                    token inputs:texture:format = "latlong"
                    float xformOp:rotateY = 0
                    uniform token[] xformOpOrder = ["xformOp:rotateY"]
                }

            }
        }
    }
}
