#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 42
        float horizontalAperture = 36
        float verticalAperture = 27
        matrix4d xformOp:transform = ( (0.8479983040050878, 1.387778780781445e-17, -0.5299989400031799, 0), (-0.14081738666722207, 0.9640574933371358, -0.22530781866755525, 0), (0.5109494495708048, 0.2656937137768184, 0.8175191193132876, -0), (4.999999999999999, 3.399999999999999, 7.9999999999999964, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def "Looks"
    {
        def Material "MDL"
        {
            token outputs:mdl:surface.connect = </World/Looks/MDL/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./OmniPBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR_Opacity"
                color3f inputs:diffuse_color_constant = (0.35, 0.8, 0.55)
                bool inputs:enable_opacity = 1
                bool inputs:enable_opacity_texture = 1
                float inputs:metallic_constant = 0.1
                int inputs:opacity_mode = 1
                asset inputs:opacity_texture = @./pattern-opacity.png@
                float inputs:opacity_threshold = 0.5
                float inputs:reflection_roughness_constant = 0.42
                token outputs:out
            }
        }
    }

    def Cube "Plinth"
    {
        color3f[] primvars:displayColor = [(0.18, 0.22, 0.25)]
        double size = 1
        float3 xformOp:scale = (4.1, 0.35, 2.6)
        double3 xformOp:translate = (0, -0.28, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "MaterialRing" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </World/Looks/MDL>
        point3f[] points = [(-1.3, 0.1, 0), (1.3, 0.1, 0), (1.3, 2.3, 0), (-1.3, 2.3, 0)]
        color3f[] primvars:displayColor = [(0.4, 0.7, 0.5)]
        texCoord2f[] primvars:st = [(0, 0), (3, 0), (3, 3), (0, 3)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }

    def Sphere "Bead0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/MDL>
        color3f[] primvars:displayColor = [(0.35, 0.5, 0.55)]
        double radius = 0.35
        double3 xformOp:translate = (-1.2, 0.35, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Bead1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/MDL>
        color3f[] primvars:displayColor = [(0.35, 0.5, 0.55)]
        double radius = 0.35
        double3 xformOp:translate = (0, 0.35, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Bead2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/MDL>
        color3f[] primvars:displayColor = [(0.35, 0.5, 0.55)]
        double radius = 0.35
        double3 xformOp:translate = (1.2, 0.35, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "OuterRing" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4