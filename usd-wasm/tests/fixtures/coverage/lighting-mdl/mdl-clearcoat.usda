                bool inputs:enable_clearcoat
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.55
                token outputs:out
            }
            variantSet "effect" = {
                "disabled" {
                    over "Shader"
                    {
                        bool inputs:enable_clearcoat = 0
                    }

                }
                "enabled" {
                    over "Shader"
                    {
                        bool inputs:enable_clearcoat = 1
                    }

                }
            }
        }
    }

