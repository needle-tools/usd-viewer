#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.19, 0.27, 0.33)]
        double size = 1
        float3 xformOp:scale = (4, 0.2, 2)
        double3 xformOp:translate = (0, -0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "BodyA" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.85, 0.38, 0.18)]
        double size = 1
        float3 xformOp:scale = (0.65, 0.65, 0.65)
        double3 xformOp:translate = (-1.05, 0.25, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "BodyB" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (1.05, 0.25, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Visual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.2, 0.65, 0.8)]
            double size = 1
            float3 xformOp:scale = (0.65, 0.65, 0.65)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Cube "RackPost0"
    {
        color3f[] primvars:displayColor = [(0.78, 0.66, 0.35)]
        double size = 1
        float3 xformOp:scale = (0.12, 1.8, 0.12)
        double3 xformOp:translate = (-1.05, 0.95, -0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Cell0"
    {
        color3f[] primvars:displayColor = [(0.36, 0.47, 0.55)]
        double size = 1
        float3 xformOp:scale = (0.85, 0.08, 0.85)
        double3 xformOp:translate = (-1.05, -0.1, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RackPost1"
    {
        color3f[] primvars:displayColor = [(0.78, 0.66, 0.35)]
        double size = 1
        float3 xformOp:scale = (0.12, 1.8, 0.12)
        double3 xformOp:translate = (0, 0.95, -0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Cell1"
    {
        color3f[] primvars:displayColor = [(0.36, 0.47, 0.55)]
        double size = 1
        float3 xformOp:scale = (0.85, 0.08, 0.85)
        double3 xformOp:translate = (0, -0.1, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RackPost2"
    {
        color3f[] primvars:displayColor = [(0.78, 0.66, 0.35)]
        double size = 1
        float3 xformOp:scale = (0.12, 1.8, 0.12)
        double3 xformOp:translate = (1.05, 0.95, -0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Cell2"
    {
        color3f[] primvars:displayColor = [(0.36, 0.47, 0.55)]
        double size = 1
        float3 xformOp:scale = (0.85, 0.08, 0.85)
        double3 xformOp:translate = (1.05, -0.1, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RackTop"
    {
        color3f[] primvars:displayColor = [(0.78, 0.66, 0.35)]
        double size = 1
        float3 xformOp:scale = (2.4, 0.12, 0.12)
        double3 xformOp:translate = (0, 1.85, -0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def PhysicsCollisionGroup "Group"
    {
        rel collection:colliders:includes = </World/BodyA>
    }
}
