#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Volume "Volume"
    {
        float3[] extent = [(-3.381325, -3.2561352, -1.2574142), (3.381325, 3.2561355, 9.2783375)]
        custom rel field:density = </World/Density>
    }

    def OpenVDBAsset "Density"
    {
        token fieldName = "density"
        asset filePath = @./smoke_000002.vdb@
        asset filePath.timeSamples = {
            1: @./smoke_000002.vdb@,
            24: @./smoke_000001.vdb@,
            48: @./smoke_000002.vdb@,
        }
    }
}

