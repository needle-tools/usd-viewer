#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.19, 0.27, 0.33)]
        double size = 1
        float3 xformOp:scale = (4, 0.2, 2)
        double3 xformOp:translate = (0, -0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "BodyA" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.1, 0, 0)
        float physics:mass = 3
        color3f[] primvars:displayColor = [(0.85, 0.38, 0.18)]
        double size = 1
        float3 xformOp:scale = (1.15, 1.15, 1.15)
        double3 xformOp:translate = (-1.2, 0.32, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "BodyB" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (1.2, 0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Visual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.2, 0.65, 0.8)]
            double size = 1
            float3 xformOp:scale = (0.65, 0.65, 0.65)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Cube "Beam"
    {
        color3f[] primvars:displayColor = [(0.86, 0.68, 0.35)]
        double size = 1
        float3 xformOp:scale = (3.4, 0.13, 0.3)
        double3 xformOp:translate = (0, -0.17, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Fulcrum"
    {
        color3f[] primvars:displayColor = [(0.35, 0.46, 0.5)]
        double size = 1
        float3 xformOp:scale = (0.3, 0.55, 0.6)
        double3 xformOp:translate = (0, -0.36, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WeightMark0"
    {
        color3f[] primvars:displayColor = [(0.98, 0.73, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.12, 0.7, 0.04)
        double3 xformOp:translate = (-1.65, 0.32, 0.58)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WeightMark1"
    {
        color3f[] primvars:displayColor = [(0.98, 0.73, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.12, 0.7, 0.04)
        double3 xformOp:translate = (-0.75, 0.32, 0.58)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
