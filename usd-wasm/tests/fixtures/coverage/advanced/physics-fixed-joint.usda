#usda 1.0
(
    defaultPrim = "World"
    framesPerSecond = 24
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.19, 0.27, 0.33)]
        double size = 1
        float3 xformOp:scale = (4, 0.2, 2)
        double3 xformOp:translate = (0, -0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "BodyA" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
    )
    {
        bool physics:kinematicEnabled = 1
        color3f[] primvars:displayColor = [(0.85, 0.38, 0.18)]
        double size = 1
        float3 xformOp:scale = (0.45, 1.65, 0.55)
        double3 xformOp:translate = (-1, 0.1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "BodyB" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (1, 0.1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Visual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.2, 0.65, 0.8)]
            double size = 1
            float3 xformOp:scale = (0.45, 1.65, 0.55)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ArchBeam"
        {
            color3f[] primvars:displayColor = [(0.96, 0.67, 0.24)]
            double size = 1
            float3 xformOp:scale = (2.45, 0.28, 0.65)
            double3 xformOp:translate = (-1, 0.87, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Bolt0"
        {
            color3f[] primvars:displayColor = [(0.18, 0.25, 0.31)]
            double size = 1
            float3 xformOp:scale = (0.15, 0.15, 0.07)
            double3 xformOp:translate = (-1.65, 0.88, 0.36)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Bolt1"
        {
            color3f[] primvars:displayColor = [(0.18, 0.25, 0.31)]
            double size = 1
            float3 xformOp:scale = (0.15, 0.15, 0.07)
            double3 xformOp:translate = (-0.35, 0.88, 0.36)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsFixedJoint "Joint"
    {
        rel physics:body0 = </World/BodyA>
        rel physics:body1 = </World/BodyB>
        point3f physics:localPos0 = (2.2222223, 0.52727276, 0)
        point3f physics:localPos1 = (-1, 0.87, 0)
    }
}
