#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Subject"
    {
        color3f[] primvars:displayColor = [(0.2, 0.7, 0.65)]
        double size = 1
        float3 xformOp:scale = (1.5, 1.5, 1.5)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "DisplayBase"
    {
        color3f[] primvars:displayColor = [(0.16, 0.23, 0.29)]
        double size = 1
        float3 xformOp:scale = (4.6, 0.2, 2.5)
        double3 xformOp:translate = (0, -1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Speaker0"
    {
        color3f[] primvars:displayColor = [(0.15, 0.2, 0.25)]
        double size = 1
        float3 xformOp:scale = (0.7, 1.55, 0.5)
        double3 xformOp:translate = (-1.55, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "SpeakerCone00"
    {
        color3f[] primvars:displayColor = [(0.95, 0.59, 0.2)]
        double radius = 0.24
        double3 xformOp:translate = (-1.55, -0.38, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "SpeakerCone01"
    {
        color3f[] primvars:displayColor = [(0.95, 0.59, 0.2)]
        double radius = 0.24
        double3 xformOp:translate = (-1.55, 0.35, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Speaker1"
    {
        color3f[] primvars:displayColor = [(0.15, 0.2, 0.25)]
        double size = 1
        float3 xformOp:scale = (0.7, 1.55, 0.5)
        double3 xformOp:translate = (1.55, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "SpeakerCone10"
    {
        color3f[] primvars:displayColor = [(0.95, 0.59, 0.2)]
        double radius = 0.24
        double3 xformOp:translate = (1.55, -0.38, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "SpeakerCone11"
    {
        color3f[] primvars:displayColor = [(0.95, 0.59, 0.2)]
        double radius = 0.24
        double3 xformOp:translate = (1.55, 0.35, 0.27)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def SpatialAudio "Audio"
    {
        uniform timecode endTime = 12
        uniform asset filePath = @./spatial-tone.wav@
        double gain = 0.5
        uniform timecode startTime = 1
    }
}

