#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.19, 0.27, 0.33)]
        double size = 1
        float3 xformOp:scale = (4, 0.2, 2)
        double3 xformOp:translate = (0, -0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "BodyA" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
    )
    {
        bool physics:kinematicEnabled = 1
        color3f[] primvars:displayColor = [(0.85, 0.38, 0.18)]
        double size = 1
        float3 xformOp:scale = (0.25, 1.9, 0.4)
        double3 xformOp:translate = (-1.2, 0.3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "BodyB" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        vector3f physics:angularVelocity = (0, 35, 0)
        double3 xformOp:translate = (-0.15, 0.3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Visual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.2, 0.65, 0.8)]
            double size = 1
            float3 xformOp:scale = (1.65, 1.75, 0.22)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Sphere "Knob"
        {
            color3f[] primvars:displayColor = [(0.98, 0.8, 0.3)]
            double radius = 0.12
            double3 xformOp:translate = (0.6, -0.1, 0.18)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "DoorInset"
        {
            color3f[] primvars:displayColor = [(0.12, 0.36, 0.42)]
            double size = 1
            float3 xformOp:scale = (1.2, 1.25, 0.04)
            double3 xformOp:translate = (0, 0, 0.125)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Cube "Hinge0"
    {
        color3f[] primvars:displayColor = [(0.95, 0.7, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.25, 0.22, 0.25)
        double3 xformOp:translate = (-1.05, -0.45, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Hinge1"
    {
        color3f[] primvars:displayColor = [(0.95, 0.7, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.25, 0.22, 0.25)
        double3 xformOp:translate = (-1.05, 0.85, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def PhysicsRevoluteJoint "Joint"
    {
        uniform token physics:axis = "Y"
        rel physics:body0 = </World/BodyA>
        rel physics:body1 = </World/BodyB>
        point3f physics:localPos0 = (0.6, 0, 0)
        point3f physics:localPos1 = (-0.9, 0, 0)
        float physics:lowerLimit = -30
        float physics:upperLimit = 30
    }
}
