    def Scope "Looks"
    {
        def Material "Brass"
        {
            token outputs:surface.connect = </World/Looks/Brass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.6, 0.26)
                color3f inputs:diffuseColor.connect = </World/Looks/Brass/Color.outputs:result>
                float inputs:metallic = 0.85
                float inputs:roughness = 0.3
                token outputs:surface
            }

            def Shader "Color"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.8, 0.6, 0.26)
                string inputs:varname = "displayColor"
                float3 outputs:result
            }
        }

        def Material "Lapis"
        {
            token outputs:surface.connect = </World/Looks/Lapis/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.8
                float inputs:clearcoatRoughness = 0.06
                color3f inputs:diffuseColor = (0.12, 0.25, 0.5)
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

