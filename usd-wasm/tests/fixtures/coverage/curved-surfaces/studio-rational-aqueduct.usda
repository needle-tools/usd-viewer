    def Scope "Looks"
    {
        def Material "Limestone"
        {
            token outputs:surface.connect = </World/Looks/Limestone/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.68, 0.46)
                color3f inputs:diffuseColor.connect = </World/Looks/Limestone/Color.outputs:result>
                float inputs:roughness = 0.8
                token outputs:surface
            }

            def Shader "Color"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.82, 0.68, 0.46)
                string inputs:varname = "displayColor"
                float3 outputs:result
            }
        }
    }

