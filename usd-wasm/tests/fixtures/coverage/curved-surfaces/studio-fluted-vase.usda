    def Scope "Looks"
    {
        def Material "Glaze"
        {
            token outputs:surface.connect = </World/Looks/Glaze/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.6
                float inputs:clearcoatRoughness = 0.06
                color3f inputs:diffuseColor = (0.8, 0.55, 0.4)
                color3f inputs:diffuseColor.connect = </World/Looks/Glaze/Texture.outputs:rgb>
                float inputs:roughness = 0.35
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/studio-uv-grid.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Looks/Glaze/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

    def Camera "Camera"
    {
        float2 clippingRange = (0.1084, 54.212)
        float focalLength = 50
        float horizontalAperture = 36
        float verticalAperture = 27
        matrix4d xformOp:transform = ( (0.919145, 0, -0.393919, 0), (-0.133786, 0.940559, -0.312168, 0), (0.370505, 0.339629, 0.864511, 0), (1.981915, 3.039699, 4.655899, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}
