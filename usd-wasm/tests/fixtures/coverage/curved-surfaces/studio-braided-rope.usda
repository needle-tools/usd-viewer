#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Fibre"
        {
            token outputs:surface.connect = </World/Looks/Fibre/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.7, 0.5)
                color3f inputs:diffuseColor.connect = </World/Looks/Fibre/Color.outputs:result>
                float inputs:roughness = 0.72
                token outputs:surface
            }

            def Shader "Color"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.8, 0.7, 0.5)
                string inputs:varname = "displayColor"
                float3 outputs:result
            }
        }
    }

