            token outputs:surface.connect = </World/Looks/Concrete/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.83, 0.78)
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Shadow"
