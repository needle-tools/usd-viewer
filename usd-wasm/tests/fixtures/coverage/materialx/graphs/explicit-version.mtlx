<?xml version="1.0"?>
<materialx version="1.39">
  
  <nodedef name="ND_v1" node="versioned" version="1.0">
    <input name="amount" type="float" value="0.2" />
    <output name="out" type="float" />
  </nodedef>
  <nodedef name="ND_v2" node="versioned" version="2.0" isdefaultversion="true">
    <input name="amount" type="float" value="0.3" />
    <output name="out" type="float" />
  </nodedef>
  <nodegraph name="NG_v1" nodedef="ND_v1">
    <multiply name="m" type="float">
      <input name="in1" type="float" interfacename="amount" />
      <input name="in2" type="float" value="2" />
    </multiply>
    <output name="out" type="float" nodename="m" />
  </nodegraph>
  <nodegraph name="NG_v2">
    <multiply name="m" type="float">
      <input name="in1" type="float" interfacename="amount" />
      <input name="in2" type="float" value="3" />
    </multiply>
    <output name="out" type="float" nodename="m" />
  </nodegraph>
  <implementation name="IM_v2" nodedef="ND_v2" nodegraph="NG_v2" />
  <nodegraph name="NG">
    <versioned name="n" type="float" version="1.0" />
    <output name="out" type="color3" nodename="p_11" />
    <texcoord name="p_1" type="vector2" />
    <multiply name="p_2" type="float">
      <input name="in1" type="float" nodename="n" />
      <input name="in2" type="float" value="10" />
    </multiply>
    <extract name="p_3" type="float">
      <input name="in" type="vector2" nodename="p_1" />
      <input name="index" type="integer" value="0" />
    </extract>
    <extract name="p_4" type="float">
      <input name="in" type="vector2" nodename="p_1" />
      <input name="index" type="integer" value="1" />
    </extract>
    <multiply name="p_5" type="float">
      <input name="in1" type="float" nodename="p_2" />
      <input name="in2" type="float" value="6.283185307179586" />
    </multiply>
    <multiply name="p_6" type="float">
      <input name="in1" type="float" nodename="p_3" />
      <input name="in2" type="float" nodename="p_5" />
    </multiply>
    <sin name="p_7" type="float">
      <input name="in" type="float" nodename="p_6" />
    </sin>
    <multiply name="p_8" type="float">
      <input name="in1" type="float" value="0.5" />
      <input name="in2" type="float" nodename="p_7" />
    </multiply>
    <add name="p_9" type="float">
      <input name="in1" type="float" value="0.5" />
      <input name="in2" type="float" nodename="p_8" />
    </add>
    <smoothstep name="p_10" type="float">
      <input name="in" type="float" nodename="p_9" />
      <input name="low" type="float" value="0.3" />
      <input name="high" type="float" value="0.7" />
    </smoothstep>
    <mix name="p_11" type="color3">
      <input name="bg" type="color3" value="0.002,0.04,0.07" />
      <input name="fg" type="color3" value="0.08,0.85,0.55" />
      <input name="mix" type="float" nodename="p_10" />
    </mix>
  </nodegraph>
  <standard_surface name="preview_surface" type="surfaceshader">
    <input name="base" type="float" value="0" />
    <input name="specular" type="float" value="0" />
    <input name="emission_color" type="color3" nodegraph="NG" output="out" />
    <input name="emission" type="float" value="1" />
  </standard_surface>
  <surfacematerial name="M" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="preview_surface" />
  </surfacematerial>
</materialx>
