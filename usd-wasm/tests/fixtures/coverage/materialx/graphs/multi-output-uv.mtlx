<?xml version="1.0"?>
<materialx version="1.39">
  
  <nodedef name="ND_split" node="split_uv">
    <input name="uv" type="vector2" defaultgeomprop="UV0" />
    <output name="outx" type="float" />
    <output name="outy" type="float" />
  </nodedef>
  <nodegraph name="NG_split" nodedef="ND_split">
    <separate2 name="s" type="multioutput">
      <input name="in" type="vector2" interfacename="uv" />
    </separate2>
    <output name="outx" type="float" nodename="s" output="outx" />
    <output name="outy" type="float" nodename="s" output="outy" />
  </nodegraph>
  <nodegraph name="NG">
    <split_uv name="uv" type="multioutput" />
    <combine3 name="n" type="color3">
      <input name="in1" type="float" nodename="uv" output="outx" />
      <input name="in2" type="float" nodename="uv" output="outy" />
      <input name="in3" type="float" value="0" />
    </combine3>
    <output name="out" type="color3" nodename="p_14" />
    <texcoord name="p_1" type="vector2" />
    <multiply name="routed_2" type="float">
      <input name="in1" type="float" nodename="uv" output="outx" />
      <input name="in2" type="float" value="1" />
    </multiply>
    <multiply name="routed_3" type="float">
      <input name="in1" type="float" nodename="uv" output="outy" />
      <input name="in2" type="float" value="1" />
    </multiply>
    <combine2 name="p_4" type="vector2">
      <input name="in1" type="float" nodename="routed_2" />
      <input name="in2" type="float" nodename="routed_3" />
    </combine2>
    <multiply name="p_5" type="float">
      <input name="in1" type="float" nodename="routed_2" />
      <input name="in2" type="float" value="25.132741228718345" />
    </multiply>
    <sin name="p_6" type="float">
      <input name="in" type="float" nodename="p_5" />
    </sin>
    <absval name="p_7" type="float">
      <input name="in" type="float" nodename="p_6" />
    </absval>
    <multiply name="p_8" type="float">
      <input name="in1" type="float" nodename="routed_3" />
      <input name="in2" type="float" value="25.132741228718345" />
    </multiply>
    <sin name="p_9" type="float">
      <input name="in" type="float" nodename="p_8" />
    </sin>
    <absval name="p_10" type="float">
      <input name="in" type="float" nodename="p_9" />
    </absval>
    <multiply name="p_11" type="float">
      <input name="in1" type="float" nodename="p_7" />
      <input name="in2" type="float" nodename="p_10" />
    </multiply>
    <smoothstep name="p_12" type="float">
      <input name="in" type="float" nodename="p_11" />
      <input name="low" type="float" value="0.03" />
      <input name="high" type="float" value="0.18" />
    </smoothstep>
    <ramp4 name="p_13" type="color3">
      <input name="valuebl" type="color3" value="0.95,0.12,0.015" />
      <input name="valuebr" type="color3" value="0.4,0.006,0.65" />
      <input name="valuetl" type="color3" value="0.06,0.65,0.8" />
      <input name="valuetr" type="color3" value="0.8,0.75,0.07" />
      <input name="texcoord" type="vector2" nodename="p_4" />
    </ramp4>
    <mix name="p_14" type="color3">
      <input name="bg" type="color3" value="0.01,0.014,0.02" />
      <input name="fg" type="color3" nodename="p_13" />
      <input name="mix" type="float" nodename="p_12" />
    </mix>
  </nodegraph>
  <standard_surface name="preview_surface" type="surfaceshader">
    <input name="base" type="float" value="0" />
    <input name="specular" type="float" value="0" />
    <input name="emission_color" type="color3" nodegraph="NG" output="out" />
    <input name="emission" type="float" value="1" />
  </standard_surface>
  <surfacematerial name="M" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="preview_surface" />
  </surfacematerial>
</materialx>
