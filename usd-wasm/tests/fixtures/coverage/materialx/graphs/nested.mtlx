    <output name="out" type="color3" nodename="inner" />
  </nodegraph>
  <nodegraph name="NG">
    <twice name="n" type="color3">
      <input name="in" type="color3" nodename="p_13" />
    </twice>
    <output name="out" type="color3" nodename="n" />
    <texcoord name="p_1" type="vector2" />
    <extract name="p_2" type="float">
