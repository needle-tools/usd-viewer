#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Sphere"
    {
        color3f[] primvars:displayColor = [(0.2, 0.6, 0.8)]
        double3 xformOp:translate = (-2.7, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "Capsule"
    {
        color3f[] primvars:displayColor = [(0.4, 0.6, 0.68)]
        double3 xformOp:translate = (-0.9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "Cone"
    {
        color3f[] primvars:displayColor = [(0.6, 0.6, 0.56)]
        double3 xformOp:translate = (0.9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cylinder"
    {
        color3f[] primvars:displayColor = [(0.8, 0.6, 0.44)]
        double3 xformOp:translate = (2.7, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

