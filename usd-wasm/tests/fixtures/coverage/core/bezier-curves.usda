#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def BasisCurves "Curves"
    {
        uniform token basis = "bezier"
        int[] curveVertexCounts = [4, 4]
        point3f[] points = [(-2, 0, 0), (-1, 2, 0), (0, 2, 0), (1, 0, 0), (-2, -1, 0), (-1, 1, 0), (0, 1, 0), (1, -1, 0)]
        uniform token type = "cubic"
        float[] widths = [0.12] (
            interpolation = "constant"
        )
        uniform token wrap = "nonperiodic"
    }
}

