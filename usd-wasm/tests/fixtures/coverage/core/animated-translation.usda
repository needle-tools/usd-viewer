        {
            color3f[] primvars:displayColor = [(0.22, 0.35, 0.4)]
            double size = 1
            float3 xformOp:scale = (0.9, 0.12, 0.9)
            double3 xformOp:translate = (0, 0.45, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Bottom"
        {
            color3f[] primvars:displayColor = [(0.22, 0.35, 0.4)]
            double size = 1
            float3 xformOp:scale = (0.9, 0.12, 0.9)
            double3 xformOp:translate = (0, -0.45, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
