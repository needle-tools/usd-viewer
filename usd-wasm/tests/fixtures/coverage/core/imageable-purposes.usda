#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "default"
    {
        color3f[] primvars:displayColor = [(0.2, 0.65, 0.8)]
        uniform token purpose = "default"
        double size = 1
        double3 xformOp:translate = (-2.25, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "render"
    {
        color3f[] primvars:displayColor = [(0.4, 0.65, 0.7)]
        uniform token purpose = "render"
        double size = 1
        double3 xformOp:translate = (-0.75, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "proxy"
    {
        color3f[] primvars:displayColor = [(0.6, 0.65, 0.6)]
        uniform token purpose = "proxy"
        double size = 1
        double3 xformOp:translate = (0.75, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "guide"
    {
        color3f[] primvars:displayColor = [(0.8, 0.65, 0.5)]
        uniform token purpose = "guide"
        double size = 1
        double3 xformOp:translate = (2.25, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

