#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 97
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Model" (
        prepend references = @./reference-time-offset-asset.usda@</Asset> (offset = -1; scale = 2)
    )
    {
        double3 xformOp:translate = (1.75, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Plinth"
    {
        color3f[] primvars:displayColor = [(0.15, 0.22, 0.27)]
        double size = 1
        float3 xformOp:scale = (6, 0.22, 2.7)
        double3 xformOp:translate = (0, -0.85, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Trim"
    {
        color3f[] primvars:displayColor = [(0.79, 0.6, 0.33)]
        double size = 1
        float3 xformOp:scale = (5.8, 0.05, 2.5)
        double3 xformOp:translate = (0, -0.73, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Reference" (
        prepend references = @./reference-time-offset-asset.usda@</Asset>
    )
    {
        double3 xformOp:translate = (-1.75, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

