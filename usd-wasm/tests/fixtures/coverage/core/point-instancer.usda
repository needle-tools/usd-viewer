#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def PointInstancer "Instances"
    {
        point3f[] positions = [(-1.5, 0, 0), (-0.5, 0, 0), (0.5, 0, 0), (1.5, 0, 0)]
        int[] protoIndices = [0, 0, 0, 0]
        rel prototypes = </World/Instances/Prototype>
        float3[] scales = [(1, 1, 1), (0.7, 1.5, 0.7), (1, 0.7, 1), (0.7, 1, 0.7)]

        def Cube "Prototype"
        {
            color3f[] primvars:displayColor = [(0.9, 0.5, 0.2)]
            double size = 0.7
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

