#usda 1.0
(
    defaultPrim = "World"
    framesPerSecond = 24
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Model" (
        prepend specializes = </_Class>
    )
    {
    }

    def Cube "Plinth"
    {
        color3f[] primvars:displayColor = [(0.15, 0.22, 0.27)]
        double size = 1
        float3 xformOp:scale = (3.5, 0.22, 2.7)
        double3 xformOp:translate = (0, -0.85, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Trim"
    {
        color3f[] primvars:displayColor = [(0.79, 0.6, 0.33)]
        double size = 1
