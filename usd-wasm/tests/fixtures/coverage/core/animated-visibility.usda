#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 48
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Base"
    {
        color3f[] primvars:displayColor = [(0.15, 0.24, 0.29)]
        double size = 1
        float3 xformOp:scale = (4.3, 0.2, 2.8)
        double3 xformOp:translate = (0, -1.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Marker"
    {
        color3f[] primvars:displayColor = [(0.3, 0.42, 0.46)]
        double size = 1
        float3 xformOp:scale = (0.45, 1.3, 0.45)
        double3 xformOp:translate = (0, -0.25, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Animated"
    {
        token visibility.timeSamples = {
            1: "inherited",
            24: "invisible",
        }
        double3 xformOp:translate = (0, 0.65, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Beacon"
        {
            color3f[] primvars:displayColor = [(0.95, 0.55, 0.12)]
            double size = 0.65
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "Ray0"
        {
            color3f[] primvars:displayColor = [(0.98, 0.78, 0.27)]
            double size = 1
            float3 xformOp:scale = (0.3, 0.08, 0.08)
            double3 xformOp:translate = (-0.55, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Ray1"
        {
            color3f[] primvars:displayColor = [(0.98, 0.78, 0.27)]
            double size = 1
            float3 xformOp:scale = (0.3, 0.08, 0.08)
            double3 xformOp:translate = (0.55, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

