    def "Robots"
    {
        def Xform "Teal" (
            instanceable = true
            prepend references = @model.usda@</Robot>
            variants = {
                string finish = "Teal"
            }
        )
        {
            float3 xformOp:rotateXYZ = (0, -12, 0)
            float3 xformOp:scale = (0.67, 0.67, 0.67)
            double3 xformOp:translate = (-1.65, 1.05, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Xform "Coral" (
            instanceable = true
            prepend references = @model.usda@</Robot>
            variants = {
                string finish = "Coral"
            }
        )
        {
            float3 xformOp:rotateXYZ = (0, 0, 0)
            float3 xformOp:scale = (0.67, 0.67, 0.67)
            double3 xformOp:translate = (0, 1.05, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Xform "Gold" (
            instanceable = true
            prepend references = @model.usda@</Robot>
            variants = {
                string finish = "Gold"
            }
        )
        {
            float3 xformOp:rotateXYZ = (0, 12, 0)
            float3 xformOp:scale = (0.67, 0.67, 0.67)
            double3 xformOp:translate = (1.65, 1.05, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }
    }

