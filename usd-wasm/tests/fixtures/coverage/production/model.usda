#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    subLayers = [
        @looks.usda@
    ]
    upAxis = "Y"
)

def Xform "Robot" (
    kind = "component"
    prepend payload = @geometry.usda@</Robot>
    variants = {
        string finish = "Teal"
    }
    prepend variantSets = "finish"
)
{
    variantSet "finish" = {
        "Coral" {
            over "Body" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robot/Looks/Coral>
            }

            over "Head" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robot/Looks/Coral>
            }

        }
        "Gold" {
            over "Body" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robot/Looks/Gold>
            }

            over "Head" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robot/Looks/Gold>
            }

        }
        "Teal" {
            over "Body" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robot/Looks/Teal>
            }

            over "Head" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robot/Looks/Teal>
            }

        }
    }
}

