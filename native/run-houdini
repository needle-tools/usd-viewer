#!/bin/zsh
set -eu
here=${0:A:h}
houdini_root=${NEEDLE_HOUDINI_ROOT:-/Applications/Houdini/Current/Frameworks/Houdini.framework/Versions/Current}
unset PYTHONPATH DYLD_LIBRARY_PATH DYLD_FALLBACK_LIBRARY_PATH
export PXR_PLUGINPATH_NAME="${NEEDLE_HOUDINI_PLUGIN_ROOT:-$here/.build/houdini/plugin/resources}"
export HOUDINI_PATH="${NEEDLE_HOUDINI_HOST_ROOT:-$here/hosts/houdini}:${HOUDINI_PATH:-&}"
exec "$houdini_root/Resources/bin/houdini" "$@"
