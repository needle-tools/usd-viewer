#usda 1.0
(
    defaultPrim="World"
    upAxis="Y"
    metersPerUnit=1
    subLayers=[@parity.usda@]
)
over "World" {
    def DistantLight "WarmKey" {
        color3f inputs:color=(1,.9,.8)
        bool inputs:enableColorTemperature=true
        float inputs:colorTemperature=5200
        float inputs:intensity=1.2
        float inputs:exposure=.75
        float inputs:angle=3
        float3 xformOp:rotateXYZ=(-25,-30,0)
        uniform token[] xformOpOrder=["xformOp:rotateXYZ"]
    }
    def RectLight "Softbox" {
        float inputs:width=2
        float inputs:height=2
        color3f inputs:color=(.4,.65,1)
        float inputs:intensity=2
        bool inputs:normalize=false
        double3 xformOp:translate=(-2,3,3)
        float3 xformOp:rotateXYZ=(-30,-20,0)
        uniform token[] xformOpOrder=["xformOp:translate","xformOp:rotateXYZ"]
    }
}
