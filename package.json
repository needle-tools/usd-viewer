{
  "name": "usd-viewer",
  "version": "1.2.1",
  "private": true,
  "description": "OpenUSD viewer with MaterialX, WebGPU rendering, stage inspection and authoring tools",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prepare:public": "node scripts/prepare-public-runtime.mjs",
    "prepare:usd-wg-manifest": "node scripts/generate-usd-wg-assets-manifest.mjs",
    "prepare:simready-manifest": "node scripts/generate-simready-manifest.mjs",
    "test": "node --test scripts/*.test.js scripts/*.test.mjs",
    "test:release": "npm test && npm run --prefix usd-wasm test:release",
    "test:package": "npm run --prefix usd-wasm test:package"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fastify/static": "^9.1.3",
    "@meimu/mutracer": "0.2.0",
    "@needle-tools/engine": "6.0.0-canary.1793922509.calm-banana.4b54649",
    "@needle-tools/materialx": "1.8.1",
    "@sparkjsdev/spark": "2.2.0",
    "closed-chain-ik": "https://codeload.github.com/gkjohnson/closed-chain-ik-js/tar.gz/3e01f7ba953daea5b0388135d9390504fd4ea0e2",
    "dockview-core": "7.0.4",
    "fastify": "^5.8.5",
    "three": "npm:@needle-tools/three@0.185.2-alpha.8",
    "three-gpu-pathtracer": "https://registry.npmjs.org/three-gpu-pathtracer/-/three-gpu-pathtracer-0.0.27.tgz",
    "three-mesh-bvh": "https://registry.npmjs.org/three-mesh-bvh/-/three-mesh-bvh-0.9.16.tgz",
    "xatlas-web": "https://registry.npmjs.org/xatlas-web/-/xatlas-web-0.1.0.tgz",
    "@needle-tools/simready": "file:modules/simready"
  },
  "overrides": {
    "@needle-tools/materialx": "$@needle-tools/materialx",
    "three": "$three"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/needle-tools/usd-viewer.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "usd",
    "usdz",
    "viewer"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
